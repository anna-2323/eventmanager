CREATE DATABASE eventmanagement WITH TEMPLATE = template0 ENCODING = 'UTF8' LOCALE_PROVIDER = libc LOCALE = 'English_United States.1252';

CREATE SCHEMA data;

CREATE TABLE data.events (
    id serial primary key,
    title varchar(255) NOT NULL,
    begins_at timestamp with time zone NOT NULL,
    venue_id integer NOT NULL,
    img_path varchar(225) DEFAULT '/res/default1.png',
    organizer_id integer NOT NULL,
    uploaded_at timestamp with time zone DEFAULT now()
);

CREATE TABLE data.users (
    id serial primary key,
    role integer DEFAULT 2,
    email varchar(255) NOT NULL,
    password varchar(255) NOT NULL,
    first_name varchar(255),
    last_name varchar(255),
    phone varchar(255),
    deleted_on timestamp with time zone
);

CREATE TABLE data.venues (
    id serial primary key,
    city varchar(255) NOT NULL,
    address varchar(255) NOT NULL,
    venue_name varchar(255) NOT NULL,
    has_sectors boolean DEFAULT false
);

CREATE TABLE data.layouts (
    id serial primary key,
    venue_id integer,
    layout_id integer,
    name character varying(100),
    svg_viewbox character varying(50) DEFAULT '0 0 800 600'::character varying,
    background_svg text,
    UNIQUE (venue_id, layout_id)
);

CREATE TABLE data.sectors (
    id serial primary key,
    venue_id integer NOT NULL,
    name character varying(100),
    display_order integer DEFAULT 1,
    svg_path text,
    color character varying(7),
    UNIQUE (venue_id, name)
);

CREATE TABLE data.layout_sectors (
    id serial primary key,
    layout_id integer NOT NULL,
    sector_id integer NOT NULL,
    capacity integer NOT NULL,
    price numeric(10,2) DEFAULT 0 NOT NULL,
    CONSTRAINT layout_sectors_capacity_check CHECK ((capacity > 0)),
    UNIQUE (layout_id, sector_id)
);

CREATE TABLE data.tickets (
    id serial primary key,
    event_id integer,
    user_id integer,
    sector_id integer,
    first_name varchar(255) NOT NULL,
    last_name varchar(255) NOT NULL,
    email varchar(255) NOT NULL,
    phone varchar(50) NOT NULL,
    purchased_at timestamp with time zone DEFAULT now(),
    access_token UUID NOT NULL DEFAULT gen_random_uuid()
);

CREATE TABLE data.password_resets (
    token      VARCHAR(128) PRIMARY KEY,
    user_id    INT,
    expires_at TIMESTAMPTZ DEFAULT NOW() + INTERVAL '1 hour'
);

ALTER TABLE ONLY data.events
    ADD CONSTRAINT fk_organizers_events FOREIGN KEY (organizer_id) REFERENCES data.users(id);

ALTER TABLE ONLY data.events
    ADD CONSTRAINT fk_venues_events FOREIGN KEY (venue_id) REFERENCES data.venues(id);
    
ALTER TABLE ONLY data.events
    ADD CONSTRAINT events_layout_id_fkey FOREIGN KEY (layout_id) REFERENCES data.layouts(id);

ALTER TABLE ONLY data.tickets
    ADD CONSTRAINT tickets_event_id_fkey FOREIGN KEY (event_id) REFERENCES data.events(id);

ALTER TABLE ONLY data.tickets
    ADD CONSTRAINT tickets_user_id_fkey FOREIGN KEY (user_id) REFERENCES data.users(id);

ALTER TABLE ONLY data.tickets
    ADD CONSTRAINT tickets_sector_id_fkey FOREIGN KEY (sector_id) REFERENCES data.layout_sectors(id);

ALTER TABLE ONLY data.password_resets
    ADD CONSTRAINT resets_user_id_fkey FOREIGN KEY (user_id) REFERENCES data.users(id);

ALTER TABLE ONLY data.layouts
    ADD CONSTRAINT venue_layouts_venue_id_fkey FOREIGN KEY (venue_id) REFERENCES data.venues(id);

ALTER TABLE ONLY data.sectors
    ADD CONSTRAINT sectors_venue_id_fkey FOREIGN KEY (venue_id) REFERENCES data.venues(id) ON DELETE CASCADE;

ALTER TABLE ONLY data.layout_sectors
    ADD CONSTRAINT layout_sectors_layout_id_fkey FOREIGN KEY (layout_id) REFERENCES data.layouts(id) ON DELETE CASCADE;

ALTER TABLE ONLY data.layout_sectors
    ADD CONSTRAINT layout_sectors_sector_id_fkey FOREIGN KEY (sector_id) REFERENCES data.sectors(id) ON DELETE CASCADE;


